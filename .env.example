# Django core
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: sqlite:///db.sqlite3  OR  postgres://user:password@host:5432/dbname
# Default below targets the docker-compose / local postgres container.
DATABASE_URL=postgres://healthcare:healthcare@localhost:5432/healthcare
# For local dev without PostgreSQL, use: DATABASE_URL=sqlite:///db.sqlite3

# JWT lifetimes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
